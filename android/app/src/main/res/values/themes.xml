<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NutriScan" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Status Bar & Navigation Bar matching Bento UI -->
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>

        <!-- Native Splash Window Background with centered launcher icon -->
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Android 12+ (API 31+) Native Splash Screen Attributes -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_foreground</item>

        <!-- Primary Brand Accent -->
        <item name="colorPrimary">@color/primary_emerald</item>
        <item name="colorPrimaryVariant">@color/primary_emerald_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>
</resources>
